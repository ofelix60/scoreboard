<mxCell id="dnote" value="CI publishes images and never deploys: the role it assumes can push to one ECR repository and nothing else. Changing what runs is a person reading a terraform plan. The old instance keeps serving until the new one passes /readyz." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="470" height="70" as="geometry"/></mxCell>
