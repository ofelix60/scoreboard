# Copy to .env and fill in. .env is gitignored AND dockerignored —
# secrets are passed at run time, never baked into an image layer.
#
# Compose reads this file twice: once via `env_file:` for the api service,
# and once for ${VAR} substitution in the db service's environment block.

# Must match the db service's container_name in docker-compose.yaml.
DB_HOST=sb-db
DB_PORT=5432

DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=scoreboard
